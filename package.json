{
  "name": "midi-timecode-notes",
  "version": "1.0.0",
  "description": "Collaborative note sharing with MIDI Timecode integration",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test test/eos-osc.test.js test/acn-midi.test.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" server.js"
  },
  "dependencies": {
    "easymidi": "^3.1.0",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "node-osc": "^11.2.2",
    "openid-client": "^6.8.8",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "allowScripts": {
    "@julusian/midi@3.6.1": true,
    "fsevents@2.3.3": true
  }
}
