# Copy to .env (git-ignored) and edit. `npm start` / `npm run dev` read it.
# REQUIRED lines are uncommented; every OPTIONAL line is commented out with its
# default, so uncomment only what you want to change. Never commit real secrets.

# ---- Required ---------------------------------------------------------------

# REQUIRED. Signs login cookies; the server won't start without it. Changing it
# logs everyone out. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Login (Keycloak) -------------------------------------------------------
# All three are needed for login. Without them the server starts but every page
# returns 503 at /login until they are set and the server is restarted.
# One shared client covers every venue.

# Keycloak realm URL. An http:// issuer is accepted (venue LAN without TLS).
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/example
KEYCLOAK_CLIENT_ID=
# Client secret from the Keycloak client's Credentials tab.
KEYCLOAK_CLIENT_SECRET=

# Session cookie name (default carries the port, so instances on one host don't clash).
# SESSION_COOKIE_NAME=bts-notes.sid.80

# ---- Server and Eos (all optional) -----------------------------------------

# HTTP port of the web app.
# PORT=80
# UDP port the app listens on for OSC (scene labels, record cues).
# OSC_PORT=8001
# Eos console address, used until a venue is chosen on the Config & Status page.
# EOS_HOST=10.10.160.143
# Eos OSC-over-TCP port.
# EOS_PORT=3037
# Give up connecting to Eos after this many ms.
# EOS_CONNECT_TIMEOUT_MS=10000
# Set to 1 to log every decoded Eos TCP message.
# DEBUG_EOS=

# ---- Network timecode (all optional) ---------------------------------------

# Multicast group the ETC Response MIDI gateway sends to.
# GATEWAY_MCAST=239.194.242.66
# Only accept timecode from this gateway IP (set it if several gateways exist).
# GATEWAY_IP=
# Local IP of the interface to join the group on; only a first-run default,
# an interface chosen on the Config & Status page replaces it. Default: automatic.
# GATEWAY_IFACE=

# ---- OBS recording (optional; off unless OBS_WEBSOCKET_URL or _PASSWORD is set)

# OBS WebSocket address (a bare host:port gets ws:// added).
# OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
# OBS WebSocket password.
# OBS_WEBSOCKET_PASSWORD=
# If set, /bts/record/* OSC cues must carry it as an argument, else they are ignored.
# OBS_OSC_SECRET=
# Folder OBS records to (default ~/Movies on macOS, ~/Videos elsewhere).
# VIDEOS_DIR=
# How often (ms) to scan VIDEOS_DIR for recordings finished while disconnected.
# OBS_SCAN_MS=30000
# Delay (ms) before retrying a lost OBS connection.
# OBS_RETRY_MS=5000
# Seconds (-60 to 60) added to each new recording's start; positive = notes land
# later in the video. Applies only to recordings added after it is set.
# VIDEO_OFFSET_S=0
# Largest accepted recording upload, in bytes (default 32 GiB).
# RECORDING_MAX_BYTES=34359738368

# ---- Lumens camera preset recall (optional; off unless CAMERA_HOST is set) -

# Camera host name or IP, reachable over HTTP.
# CAMERA_HOST=
# Camera web login.
# CAMERA_USERNAME=
# CAMERA_PASSWORD=
# Preset number (1-255) recalled before a recording starts and, if enabled below, on scene changes.
# CAMERA_PRESET=
# Also recall CAMERA_PRESET on every scene change (1, true, yes or on).
# CAMERA_RECALL_ON_SCENE=
# Per-request timeout in ms (200-10000).
# CAMERA_TIMEOUT_MS=2000

# ---- Storage locations (all optional; default to git-ignored paths next to server.js)

# BACKUPS_DIR=./backups
# SAVED_SHOWS_DIR=./saved-shows
# RESETS_DIR=./reset-notes
# RECORDINGS_DIR=./recordings
# SETTINGS_FILE=./local-settings.json
# SESSIONS_FILE=./local-sessions.json
# TAGS_FILE=./tags.json

# ---- Tuning and development (all optional) ---------------------------------

# How long (ms) after start browsers may offer their chat copy for restore (default 30 min).
# CHAT_RESTORE_WINDOW_MS=1800000
# How long (ms) reset notes are kept (default 3 days).
# RESET_KEEP_MS=259200000
# Delay (ms) after a change before the notes backup is written.
# BACKUP_DELAY_MS=1000
# Interval (ms) of the safety-net notes backup.
# BACKUP_INTERVAL_MS=60000
# `npm run dev:playback` only: port of the sample instance, and 1 to seed invented demo notes.
# PLAYBACK_PORT=3030
# PLAYBACK_DEMO=1
