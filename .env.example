# Copy to .env. Required in every mode:
SESSION_SECRET=change-me

# Keycloak login is OFF unless this is 1/true/on/yes. Off: people pick a name and
# anyone who can reach the server gets in (settings included). With it set to 1 all
# three KEYCLOAK_* values below are required; 0 ignores them. Setting them without
# KEYCLOAK_ENABLED stops the server starting.
KEYCLOAK_ENABLED=1
KEYCLOAK_ISSUER=https://sso.example/realms/bts
KEYCLOAK_CLIENT_ID=bts-dress-notes
KEYCLOAK_CLIENT_SECRET=
